[Unit]
Description=n8n workflow automation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=n8n
Group=n8n
WorkingDirectory=/var/lib/n8n
EnvironmentFile=/etc/n8n/n8n.env
Environment=PATH=/opt/node-v{{ n8n_node_version }}-linux-x64/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/node-v{{ n8n_node_version }}-linux-x64/bin/node /opt/n8n/current/node_modules/n8n/bin/n8n start
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/n8n

[Install]
WantedBy=multi-user.target
