NODE_ENV=production
HOME=/var/lib/n8n
N8N_USER_FOLDER=/var/lib/n8n
N8N_LISTEN_ADDRESS={{ n8n_address }}
N8N_PORT={{ n8n_port }}
N8N_HOST={{ n8n_hostname }}
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://{{ n8n_hostname }}/
N8N_WEBHOOK_URL=https://{{ n8n_hostname }}/
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=true
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
EXTERNAL_HOOK_FILES=/etc/n8n/pangolin-auth.js
GENERIC_TIMEZONE={{ n8n_timezone }}
TZ={{ n8n_timezone }}
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
NODES_EXCLUDE={{ n8n_excluded_nodes | to_json }}
N8N_DISABLED_MODULES={{ n8n_disabled_modules | join(',') }}
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
