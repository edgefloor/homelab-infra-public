[Unit]
Description=NeroCD production stack
Wants=network-online.target docker.service
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ nerocd_runtime_dir }}
ExecStart=/usr/bin/docker compose --env-file .env -f compose.production.yaml -f compose.homelab.yml up -d --remove-orphans
ExecReload=/usr/bin/docker compose --env-file .env -f compose.production.yaml -f compose.homelab.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file .env -f compose.production.yaml -f compose.homelab.yml stop
TimeoutStartSec=600
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
