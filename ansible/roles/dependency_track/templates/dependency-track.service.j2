[Unit]
Description=OWASP Dependency-Track API
After=network-online.target postgresql@17-dtrack.service
Requires=postgresql@17-dtrack.service
RequiresMountsFor={{ dependency_track_data_root }}

[Service]
Type=simple
User=dependency-track
Group=dependency-track
WorkingDirectory=/opt/dependency-track/current
Environment=TZ=UTC
ExecStart=/opt/dependency-track/java-{{ dependency_track_java_version }}/bin/java -Duser.timezone=UTC -Xms512m -Xmx{{ dependency_track_heap }} -XX:+UseG1GC -XX:+UseStringDeduplication -XX:+UseCompactObjectHeaders -XX:MaxGCPauseMillis=250 -XX:+ExitOnOutOfMemoryError --add-opens java.base/java.util.concurrent=ALL-UNNAMED --enable-native-access=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow -Djdk.http.auth.tunneling.disabledSchemes= -cp "dependency-track-apiserver.jar:lib/*:lib-external/*" org.dependencytrack.Application -host 127.0.0.1 -port {{ dependency_track_api_port }} -context /
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
