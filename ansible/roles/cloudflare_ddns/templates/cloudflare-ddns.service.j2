[Unit]
Description=Reconcile declared Cloudflare DNS routes
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile={{ cloudflare_ddns_environment_file }}
ExecStart=/usr/local/libexec/cloudflare-ddns
User=root
Group=root
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
UMask=0077
